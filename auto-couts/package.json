{
  "name": "auto-couts",
  "version": "1.0.0",
  "private": true,
  "description": "Gestion et simulation des coûts automobiles d'un foyer",
  "scripts": {
    "postinstall": "prisma generate",
    "db:setup": "prisma db push --skip-generate && tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx prisma/seed.ts",
    "predev": "npm run db:setup",
    "dev": "next dev",
    "prebuild": "npm run db:setup",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:html": "vite build --config spa/vite.config.ts && node -e \"require('fs').copyFileSync('spa/dist/index.html','auto-couts.html')\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
