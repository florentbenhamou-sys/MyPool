  "content_mapping": {
    "description": "How the FootballExercise data model maps onto slots (used for both extraction and generation).",
    "title": "exercise_title",
    "theme": "tag_category",
    "sessionPhase": "tag_moment",
    "areaDimensions": "section_espace.body",
    "playerCount": "section_effectif.body (sum of team slots)",
    "durationMinutes": "section_temps.body (first number followed by 'minutes')",
    "objective": "section_but.body",
    "instructions": "section_regles.body",
    "variations": "section_variables.body",
    "coachingPoints": "section_comportements.body",
    "visuals": ["diagram"],
    "not_present_in_template": ["ageGroup", "equipment", "successCriteria (closest: comportements)", "speakerNotes"]
  },

  "hierarchy": [
    { "rank": 1, "component": "exercise_title", "why": "only black fill, maximum contrast, top centre of the reading zone" },
    { "rank": 2, "component": "diagram", "why": "largest saturated area (green pitch), right column" },
    { "rank": 3, "component": "coach_band_title", "why": "full-width gold band, splits the page in two" },
    { "rank": 4, "component": "section headers (ESPACE, BUT DU JEU, EFFECTIF, REGLES, TEMPS DE JEU)", "why": "repeated slate bars, 15 pt bold white, same height" },
    { "rank": 5, "component": "tags (Technique / Echauffement)", "why": "bright amber but small" },
    { "rank": 6, "component": "body text (rules, goal, data)", "why": "12 pt black on white" },
    { "rank": 7, "component": "VARIABLES / COMPORTEMENTS on grey frames", "why": "muted grey headers and tinted frames read as secondary" },
    { "rank": 8, "component": "legend, logo", "why": "small, low-contrast green captions, static content" }
  ],

  "generation": {
    "strategy": "clone-and-fill: the template slide is duplicated once per sheet and each named shape is refilled; geometry, effects and static elements are never re-created.",
    "font_metrics": {
      "note": "Average advance width per character, measured on the render (Roboto / Carlito ≡ Calibri metrics). Used only to estimate wrapping.",
      "Calibri": { "em_ratio": 0.415 },
      "Roboto": { "em_ratio": 0.48 },
      "Roboto-Bold-caps": { "em_ratio": 0.53 }
    },
    "line_height_ratio": 1.2,
    "min_font_size_pt": 10,
    "slots": {
      "category":   { "shape": "TypeExercice",     "kind": "text",    "font": "Roboto", "max_lines": 1, "min_font_size_pt": 8 },
      "moment":     { "shape": "TypeMoment",       "kind": "text",    "font": "Roboto", "max_lines": 1, "min_font_size_pt": 8 },
      "title":      { "shape": "ObjectifExercice", "kind": "text",    "font": "Roboto-Bold-caps", "uppercase": true, "max_lines": 1, "min_font_size_pt": 12 },
      "space":      { "shape": "Text_espace",      "kind": "lines",   "font": "Roboto",  "max_bottom_in": 1.75 },
      "duration":   { "shape": "Text_TempsDeJeu",  "kind": "lines",   "font": "Roboto",  "max_bottom_in": 4.6 },
      "goal":       { "shape": "Text_ButDuJeu",    "kind": "bullets", "font": "Calibri", "max_bottom_in": 1.84 },
      "rules":      { "shape": "Text_Regle",       "kind": "bullets", "font": "Calibri", "max_bottom_in": 4.92 },
      "variables":  { "shape": "Text_variables",   "kind": "groups",  "font": "Calibri", "max_bottom_in": 7.362 },
      "behaviours": { "shape": "Text_Comportements","kind": "bullets","font": "Calibri", "max_bottom_in": 7.362 },
      "teams":      { "kind": "teams", "slots": { "black": "TeamColor3", "red": "TeamColor2", "blue": "TeamColor4", "yellow": "TeamColor1" }, "label_suffix": "NBJoueurs" },
      "diagram":    { "shape": "Schema", "kind": "image", "fit": "contain", "align": "center" }
    },
    "bullet": { "char": "•", "font": "Arial", "marL_in": 0.188, "indent_in": -0.188 }
  },

  "layout_rules": [
    { "id": "R1", "rule": "Upper band = 3 columns with proportions ≈ 19.6 % / 40.9 % / 37.9 % of content width and 0.09–0.1\" gutters." },
    { "id": "R2", "rule": "Every section = coloured header bar (h 0.353\", 15 pt Roboto bold white uppercase, centred, drop shadow) directly followed by a text box starting ≤ 0.12\" below." },
    { "id": "R3", "rule": "Headers in the same column share the column's left and right axes; text boxes are inset ~0.08\" from the header's left edge in the center column." },
    { "id": "R4", "rule": "The exercise title occupies the top of the center column only, same width as the center column headers." },
    { "id": "R5", "rule": "Tags sit in the top of the left column, vertically centred on the title bar, right-aligned to the left column edge." },
    { "id": "R6", "rule": "The right column has no header: the diagram starts 0.2\" lower than the title and the legend sits under it, centred." },
    { "id": "R7", "rule": "The lower band starts at y = 5.02 with a full-width gold divider; coach headers sit 0.1\" below it, coach frames are attached to the headers (no gap) and end at y = 7.362." },
    { "id": "R8", "rule": "Frames (light grey) only exist in the coach area; upper sections have no frame (white background)." },
    { "id": "R9", "rule": "Colour coding by function: black = identity, slate = exercise set-up, gold = coaching, grey = coaching sub-sections, amber = classification tags." },
    { "id": "R10", "rule": "Body text: 12 pt, line spacing 1.0, no paragraph spacing, left aligned, one item per paragraph." },
    { "id": "R11", "rule": "Static elements (legend, coach band, logo, header labels) are reused unchanged on every sheet." }
  ]
}
