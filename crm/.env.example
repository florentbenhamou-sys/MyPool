# ---------------------------------------------------------------
# Copier ce fichier en .env puis adapter les valeurs.
# Ne JAMAIS committer le fichier .env.
# ---------------------------------------------------------------

# --- PostgreSQL (utilisé par docker-compose.yml) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm
# Port exposé sur la machine hôte (pour psql / Prisma Studio en local)
POSTGRES_PORT=5432

# --- Application ---
# Pour `npm run dev` hors Docker : base accessible sur localhost.
# Dans docker-compose, DATABASE_URL est recalculée pour pointer sur le service "db".
DATABASE_URL=postgresql://crm:change-me@localhost:5432/crm?schema=public

# Port HTTP exposé par l'application dans docker-compose
APP_PORT=3000

# Fuseau horaire métier utilisé pour saisir/afficher les dates + heures
APP_TIMEZONE=Europe/Paris

# Devise par défaut des nouvelles propositions et des catalogues (ISO 4217)
DEFAULT_CURRENCY=EUR

# Utilisateur local (mode mono-utilisateur, sans authentification).
# Il est créé automatiquement au premier besoin et sert à renseigner createdById / updatedById.
LOCAL_USER_EMAIL=moi@localhost
LOCAL_USER_NAME="Utilisateur local"

# --- Stockage des fichiers (pièces jointes RFP/RFI) ---
# Driver : "local" (V1). Un driver S3-compatible pourra être ajouté (voir README).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Taille maximale d'un fichier uploadé, en Mo
MAX_UPLOAD_MB=20
